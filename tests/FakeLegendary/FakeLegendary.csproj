<Project Sdk="Microsoft.NET.Sdk">
  <!-- Stand-in for legendary.exe used by Glider.Core.Tests. Behaviour comes from script files; see Program.cs. -->
  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net10.0</TargetFramework>
    <IsPackable>false</IsPackable>
    <InvariantGlobalization>true</InvariantGlobalization>
    <NoWarn>$(NoWarn);CA1305;CA1307;CA1310;CA1822;CA1861;CA2000;CA1852;CA1864;CA1865;CA1866;CA5350</NoWarn>
  </PropertyGroup>
</Project>
