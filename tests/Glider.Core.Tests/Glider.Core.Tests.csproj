<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <IsPackable>false</IsPackable>
    <OutputType>Exe</OutputType>
    <NoWarn>$(NoWarn);CA1707;CA1822;CA2000;CA1861;CA1307;CA1310;CA1305;CA1304;CA1311</NoWarn>
  </PropertyGroup>
  <ItemGroup>
    <PackageReference Include="xunit.v3" Version="4.0.3" />
    <PackageReference Include="xunit.runner.visualstudio" Version="4.0.1" />
  </ItemGroup>
  <ItemGroup>
    <Using Include="Xunit" />
  </ItemGroup>
  <ItemGroup>
    <ProjectReference Include="..\..\src\Glider.Core\Glider.Core.csproj" />
    <ProjectReference Include="..\..\tools\Glider.ContractGen\Glider.ContractGen.csproj" />
    <!-- Copies FakeLegendary(.exe) next to the tests; tests point AppPaths.LegendaryExe at it. -->
    <ProjectReference Include="..\FakeLegendary\FakeLegendary.csproj" />
  </ItemGroup>
  <ItemGroup>
    <!-- Pure (no WPF/Win32) host chrome logic, compiled into the tests because the WPF host has no test project of its own. -->
    <Compile Include="..\..\src\Glider.App\ChromeLogic.cs" Link="Host\ChromeLogic.cs" />
    <Compile Include="..\..\src\Glider.App\LoginWindowLayout.cs" Link="Host\LoginWindowLayout.cs" />
    <Compile Include="..\..\src\Glider.App\LoginDebugRedaction.cs" Link="Host\LoginDebugRedaction.cs" />
    <!-- Windows shell/registry adapters (self-contained): tested against real .lnk files in a temp folder and a throwaway HKCU key. -->
    <Compile Include="..\..\src\Glider.App\WindowsRegistry.cs" Link="Host\WindowsRegistry.cs" />
    <Compile Include="..\..\src\Glider.App\WindowsShellLinks.cs" Link="Host\WindowsShellLinks.cs" />
    <!-- Pure host plumbing (shutdown, bridge queue, startup failure): no WPF/WebView2 types. -->
    <Compile Include="..\..\src\Glider.App\ShutdownRunner.cs" Link="Host\ShutdownRunner.cs" />
  </ItemGroup>
  <ItemGroup>
    <None Include="Fixtures\**\*" CopyToOutputDirectory="PreserveNewest" />
  </ItemGroup>
</Project>
