<Project>
  <PropertyGroup>
    <LangVersion>latest</LangVersion>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <TreatWarningsAsErrors>true</TreatWarningsAsErrors>
    <AnalysisLevel>latest-recommended</AnalysisLevel>
    <EnforceCodeStyleInBuild>false</EnforceCodeStyleInBuild>
    <EnableWindowsTargeting>true</EnableWindowsTargeting>
    <Deterministic>true</Deterministic>
    <InvariantGlobalization>false</InvariantGlobalization>
    <Version>0.2.5</Version>
    <Authors>Glider contributors</Authors>
    <Product>Glider</Product>
    <Copyright>Copyright (c) 2026 Glider contributors</Copyright>
    <!-- CA1515 (make types internal) and CA1062 are noise for an app; CA2007 ConfigureAwait is irrelevant in Core libs consumed only by our app -->
    <NoWarn>$(NoWarn);CA1515;CA1062;CA2007;CA1848;CA1303;CA1031;CA1724;CA1716;CA1720;CA1711;CA1032;CA1002;CA2227;CA1819;CA1056;CA1054;CA1055;CA5394;CA1869</NoWarn>
  </PropertyGroup>
</Project>
